<Window x:Class="DayPlanner.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DayPlanner"
        Title="时间规划局" Width="1320" Height="780" MinWidth="1120" MinHeight="620" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" Style="{StaticResource {x:Type Window}}">
  <Grid Margin="22,18,22,12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition x:Name="OverviewRow" Height="90"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="3,0,3,22">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="DateTitle" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button x:Name="CalendarButton" Click="Calendar_Click" Padding="9" Margin="12,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="选择日期">
            <Viewbox Width="18" Height="18"><Canvas Width="24" Height="24">
              <Path Data="M5,5 L19,5 Q21,5 21,7 L21,20 Q21,22 19,22 L5,22 Q3,22 3,20 L3,7 Q3,5 5,5 M3,10 L21,10 M8,2 L8,7 M16,2 L16,7 M7,14 L10,14 M14,14 L17,14 M7,18 L10,18 M14,18 L17,18" Stroke="#34465D" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas></Viewbox>
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
          <Button Content="‹" Click="PreviousPeriod_Click" Padding="9,2" AutomationProperties.Name="上一周期"/>
          <Button x:Name="CurrentPeriodButton" Content="今天" Click="CurrentPeriod_Click" Padding="10,2" Margin="4,0"/>
          <Button Content="›" Click="NextPeriod_Click" Padding="9,2" AutomationProperties.Name="下一周期"/>
          <TextBlock x:Name="DateSubtitle" Foreground="#8491A2" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>
        <Popup x:Name="CalendarPopup" PlacementTarget="{Binding ElementName=CalendarButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
          <Border Background="White" BorderBrush="#DEE6ED" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,6,0,0">
            <Calendar x:Name="DateCalendar" Language="zh-CN" FirstDayOfWeek="Monday" SelectionMode="SingleDate" SelectedDatesChanged="Calendar_SelectedDatesChanged"/>
          </Border>
        </Popup>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="DayViewButton" Content="日" Tag="Day" Click="ViewMode_Click" Padding="20,9"/>
        <Button x:Name="WeekViewButton" Content="周" Tag="Week" Click="ViewMode_Click" Padding="20,9" Margin="3,0"/>
        <Button x:Name="MonthViewButton" Content="月" Tag="Month" Click="ViewMode_Click" Padding="20,9"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
      <StackPanel Margin="22,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="当前时间" FontSize="11" Foreground="#7F8B9D"/>
        <TextBlock x:Name="ClockText" Text="00:00:00" FontSize="29" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold"/>
      </StackPanel>
      <Button x:Name="SettingsButton" Content="设置" Click="Settings_Click" Margin="20,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="设置"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailsColumn" Width="0"/></Grid.ColumnDefinitions>
    <Border CornerRadius="10" BorderBrush="#DEE6ED" BorderThickness="1" Background="White" ClipToBounds="True">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="18,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="UndoButton" Content="↶" Click="Undo_Click" ToolTip="撤销 Ctrl+Z" Padding="10,3" Margin="0,0,5,0"/>
            <Button x:Name="RedoButton" Content="↷" Click="Redo_Click" ToolTip="重做 Ctrl+Y" Padding="10,3" Margin="0,0,12,0"/>
            <Button x:Name="NewScheduleButton" Content="+ 新建" Click="New_Click" Background="{StaticResource Accent}" Foreground="White" BorderBrush="{StaticResource Accent}" Padding="12,5"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="CountText" Foreground="#66758B"/>
            <TextBlock Text="● 时间点" Foreground="#7564F4" Margin="22,0,16,0" FontSize="12"/>
            <TextBlock Text="━ 时间段" Foreground="#008D94" FontSize="12"/>
          </StackPanel>
        </DockPanel>
        <ScrollViewer x:Name="TimelineScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
          <local:TimelineControl x:Name="Timeline" MinHeight="400"/>
        </ScrollViewer>
        <local:WeekPlannerView x:Name="WeekView" Grid.Row="1" Visibility="Collapsed"/>
        <ScrollViewer x:Name="MonthScroll" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <local:MonthPlannerView x:Name="MonthView"/>
        </ScrollViewer>
      </Grid>
    </Border>
    <Border x:Name="DetailsPanel" Grid.Column="1" Margin="14,0,0,0" Background="White" BorderBrush="#DEE6ED" BorderThickness="1" CornerRadius="10" Padding="16" Visibility="Collapsed">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
          <TextBlock x:Name="DetailsTitle" FontSize="19" FontWeight="SemiBold"/>
          <TextBlock x:Name="DetailsCount" Foreground="#8491A2" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
          <Button Content="+ 添加安排" Click="New_Click" Background="{StaticResource Accent}" Foreground="White"/>
          <Button Content="打开日视图" Click="OpenDay_Click" Margin="0,8,0,0"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="DetailsItems"/></ScrollViewer>
      </DockPanel>
    </Border>
    </Grid>
    <Grid x:Name="OverviewPanel" Grid.Row="2" Margin="4,12,4,4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="全天" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <local:OverviewControl x:Name="Overview" Grid.Column="1"/>
    </Grid>
    <DockPanel Grid.Row="3" Margin="4,8,4,0">
      <TextBlock x:Name="SaveStatus" DockPanel.Dock="Right" Text="已自动保存" Foreground="#50969A" FontSize="11" VerticalAlignment="Center"/>
      <TextBlock x:Name="InteractionHint" Text="单击创建事件 · 拖动创建日程 · 双击日程块编辑 · 右键更多操作 · Ctrl+滚轮缩放 · Shift+滚轮平移" Foreground="#8491A2" FontSize="11"/>
    </DockPanel>
  </Grid>
</Window>
