<Window x:Class="DayPlanner.EventEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑日程" Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="White" Style="{StaticResource {x:Type Window}}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="28">
    <TextBlock x:Name="Heading" Text="新建日程" FontSize="23" FontWeight="SemiBold"/>
    <TextBlock x:Name="EditorDate" Foreground="#8491A2" Margin="0,6,0,22"/>
    <TextBlock Text="内容" Margin="0,0,0,7"/>
    <TextBox x:Name="TitleInput" MaxLength="120" Height="76" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" AutomationProperties.Name="日程内容"/>
    <TextBlock Text="类型" Margin="0,18,0,7"/>
    <StackPanel Orientation="Horizontal">
      <RadioButton x:Name="PointOption" Content="时间点事件" GroupName="Kind" Checked="KindChanged" Margin="0,0,28,0"/>
      <RadioButton x:Name="SpanOption" Content="时间段日程" GroupName="Kind" Checked="KindChanged"/>
    </StackPanel>
    <Grid Margin="0,18,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock x:Name="StartLabel" Text="开始时间" Margin="0,0,0,7"/><TextBox x:Name="StartInput" AutomationProperties.Name="开始时间"/></StackPanel>
      <StackPanel x:Name="EndPanel" Grid.Column="2"><TextBlock Text="结束时间" Margin="0,0,0,7"/><TextBox x:Name="EndInput" AutomationProperties.Name="结束时间"/></StackPanel>
    </Grid>
    <TextBlock Text="24小时制，例如09:30；结束时间支持24:00" FontSize="11" Foreground="#8491A2" Margin="0,7,0,0"/>
    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
      <CheckBox x:Name="ReminderOption" Content="提前提醒" VerticalAlignment="Center" Margin="0,0,16,0"/>
      <ComboBox x:Name="ReminderLead" Width="90" IsEditable="True" Text="5" IsEnabled="{Binding IsChecked, ElementName=ReminderOption}" AutomationProperties.Name="提前提醒分钟数">
        <ComboBoxItem Content="1"/><ComboBoxItem Content="5"/><ComboBoxItem Content="10"/><ComboBoxItem Content="15"/><ComboBoxItem Content="30"/><ComboBoxItem Content="60"/><ComboBoxItem Content="120"/>
      </ComboBox>
      <TextBlock Text="分钟" Margin="8,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>
    <TextBlock Text="标记颜色" Margin="0,18,0,8"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="100">
      <WrapPanel x:Name="ColorSwatches">
        <WrapPanel.Resources>
          <Style x:Key="ColorSwatch" TargetType="RadioButton">
            <Setter Property="Width" Value="42"/><Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,9,8"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value>
              <ControlTemplate TargetType="RadioButton">
                <Border x:Name="Ring" CornerRadius="7" BorderThickness="2" BorderBrush="Transparent" Padding="3">
                  <Border Background="{TemplateBinding Background}" CornerRadius="3" BorderBrush="#20000000" BorderThickness="1">
                    <TextBlock x:Name="Check" Text="✓" Foreground="{TemplateBinding Foreground}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden"/>
                  </Border>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="#34465D"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
                  <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="#008D94"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value></Setter>
          </Style>
        </WrapPanel.Resources>
      </WrapPanel>
    </ScrollViewer>
    <Border x:Name="CustomColorPanel" Visibility="Collapsed" Background="#F4F7FA" CornerRadius="6" Padding="12" Margin="0,4,0,0">
      <StackPanel>
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border x:Name="ColorPreview" Width="28" Height="28" CornerRadius="4" BorderBrush="#CFDCE5" BorderThickness="1"/>
          <TextBox x:Name="HexInput" Grid.Column="1" TextChanged="HexChanged" MaxLength="7" AutomationProperties.Name="颜色代码"/>
          <Button x:Name="AddColorButton" Grid.Column="2" Content="添加" Click="AddColor_Click" Margin="8,0,0,0" Padding="12,6"/>
        </Grid>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="25"/><RowDefinition Height="25"/><RowDefinition Height="25"/></Grid.RowDefinitions>
          <TextBlock Text="R" VerticalAlignment="Center"/><Slider x:Name="RedSlider" Grid.Column="1" Maximum="255" IsSnapToTickEnabled="True" ValueChanged="RgbChanged" VerticalAlignment="Center" AutomationProperties.Name="红色"/>
          <TextBlock Text="G" Grid.Row="1" VerticalAlignment="Center"/><Slider x:Name="GreenSlider" Grid.Row="1" Grid.Column="1" Maximum="255" IsSnapToTickEnabled="True" ValueChanged="RgbChanged" VerticalAlignment="Center" AutomationProperties.Name="绿色"/>
          <TextBlock Text="B" Grid.Row="2" VerticalAlignment="Center"/><Slider x:Name="BlueSlider" Grid.Row="2" Grid.Column="1" Maximum="255" IsSnapToTickEnabled="True" ValueChanged="RgbChanged" VerticalAlignment="Center" AutomationProperties.Name="蓝色"/>
        </Grid>
        <TextBlock x:Name="ColorError" Foreground="#C24A40" FontSize="11" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
    <TextBlock x:Name="ErrorText" Foreground="#C24A40" TextWrapping="Wrap" Margin="0,14,0,0" MinHeight="20"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="取消" IsCancel="True" Width="80" Margin="0,0,10,0"/>
      <Button x:Name="SaveButton" Content="创建" Click="Save_Click" Width="90" Background="{StaticResource Accent}" BorderBrush="{StaticResource Accent}" Foreground="White"/>
    </StackPanel>
  </StackPanel>
  </ScrollViewer>
</Window>
