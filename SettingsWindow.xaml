<Window x:Class="DayPlanner.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="White" Style="{StaticResource {x:Type Window}}">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28">
      <TextBlock Text="设置" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,24"/>
      <TextBlock Text="默认显示时间范围" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="开始时间" Margin="0,0,0,7"/>
          <TextBox x:Name="StartInput" AutomationProperties.Name="默认开始时间"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="结束时间" Margin="0,0,0,7"/>
          <TextBox x:Name="EndInput" AutomationProperties.Name="默认结束时间"/>
        </StackPanel>
      </Grid>
      <TextBlock Text="24小时制，结束时间支持24:00，范围至少2小时。" FontSize="11" Foreground="#8491A2" Margin="0,8,0,24" TextWrapping="Wrap"/>
      <TextBlock Text="网格吸附" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,26">
        <RadioButton x:Name="Grid5Option" Content="5分钟" GroupName="Grid" Margin="0,0,28,0"/>
        <RadioButton x:Name="Grid10Option" Content="10分钟" GroupName="Grid"/>
      </StackPanel>
      <CheckBox x:Name="CloseToTrayOption" Content="关闭时最小化到托盘"/>
      <TextBlock Text="托盘运行期间继续发送日程提醒。" FontSize="11" Foreground="#8491A2" Margin="0,8,0,0"/>
      <TextBlock x:Name="ErrorText" Foreground="#C24A40" TextWrapping="Wrap" MinHeight="20" Margin="0,18,0,10"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" IsCancel="True" Width="82" Margin="0,0,10,0"/>
        <Button x:Name="SaveButton" Content="保存" Click="Save_Click" IsDefault="True" Width="90" Background="{StaticResource Accent}" Foreground="White" BorderBrush="{StaticResource Accent}"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
