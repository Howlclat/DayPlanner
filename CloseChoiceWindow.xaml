<Window x:Class="DayPlanner.CloseChoiceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关闭时间规划局" Width="430" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
  <StackPanel Margin="26">
    <TextBlock Text="如何关闭窗口？" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock Text="最小化到托盘后，日程提醒会继续运行。" Foreground="#66758B" Margin="0,10,0,20"/>
    <Button Content="最小化到托盘" Click="Minimize_Click" Background="{StaticResource Accent}" Foreground="White" BorderBrush="{StaticResource Accent}" Margin="0,0,0,10"/>
    <Button Content="退出程序" Click="Exit_Click"/>
    <CheckBox x:Name="RememberOption" Content="记住我的选择" Margin="0,18,0,12"/>
    <Button Content="取消" IsCancel="True" HorizontalAlignment="Right" Padding="16,6"/>
  </StackPanel>
</Window>
